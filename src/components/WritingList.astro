---
import ArrowCard from './ArrowCard.astro';
import { articleDate, articlePath, formatDate, type Article } from '@/lib/writing';
import { site } from '@/data/site';
interface Props { articles: Article[]; lang?: 'en' | 'zh'; }
const { articles, lang = 'en' } = Astro.props;
---
{articles.length ? (
  <ul class="card-list">
    {articles.map((article) => <li><ArrowCard href={articlePath(article)} title={article.data.title} description={article.data.description} detail={formatDate(articleDate(article)!, lang)} /></li>)}
  </ul>
) : (
  <div class="empty-state">
    <p><strong>{lang === 'zh' ? '文章会从这里开始。' : 'A place for longer thoughts.'}</strong></p>
    <p>{lang === 'zh' ? '本站尚未发布中文文章。已有中文写作可以在知乎阅读。' : 'No essays published here yet. You can find my existing writing in Chinese on Zhihu.'}</p>
    <p><a class="small-link" href={site.zhihu}>{lang === 'zh' ? '在知乎阅读 ↗' : 'Read on Zhihu ↗'}</a></p>
  </div>
)}
