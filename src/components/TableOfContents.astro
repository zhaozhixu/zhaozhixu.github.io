---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  label: string;
}
const { headings, label } = Astro.props;
---
<nav class="toc-nav" aria-label={label}>
  <ul>
    {headings.map((heading) => (
      <li class:list={{ subsection: heading.depth === 3 }}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc-nav {
    display: block;
    font: 400 13px/1.6 var(--sans);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 4px 0 12px;
    border-inline-start: 1px solid var(--line);
  }
  li + li {
    margin-top: 4px;
  }
  .subsection {
    padding-inline-start: 14px;
    font-size: 12px;
  }
  a {
    display: block;
    padding: 5px 4px;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent);
  }
</style>
