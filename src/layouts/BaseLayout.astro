---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import '@/styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-400-italic.css';
interface Props {
  title?: string; description?: string; lang?: 'en' | 'zh'; noindex?: boolean;
  type?: 'website' | 'article'; publishedAt?: Date; updatedAt?: Date;
  alternates?: { lang: string; href: string }[];
}
const { title, description = site.description, lang = 'en', noindex = false, type = 'website', publishedAt, updatedAt, alternates = [] } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · Systems, languages & open creation`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} /><meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href={new URL('/rss.xml', Astro.site)} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />)}
    <meta property="og:type" content={type} /><meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Zhixu Zhao — Systems, languages & open creation" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <script is:inline>
      (() => {
        let theme = 'system';
        try { theme = localStorage.getItem('theme') || 'system'; } catch {}
        if (!['light', 'dark', 'system'].includes(theme)) theme = 'system';
        document.documentElement.dataset.themePreference = theme;
        document.documentElement.classList.toggle('dark', theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳至正文' : 'Skip to content'}</a>
    <Header /><main id="main" tabindex="-1"><slot /></main><Footer />
  </body>
</html>
